# Required: use matching immutable release tags or, preferably, manifest
# digests. Empty values make `compose config` fail instead of pulling latest.
ESTAB_APP_IMAGE=
ESTAB_MIGRATE_IMAGE=

ESTAB_DB_PASSWORD_SECRET_FILE=./secrets/db_password.txt
ESTAB_DB_ROOT_PASSWORD_SECRET_FILE=./secrets/db_root_password.txt
ESTAB_ADMIN_PASSWORD_SECRET_FILE=./secrets/admin_password.txt

# Named-volume defaults are the most portable. For a Synology project, use
# ./data/db, ./data/4fdata and ./data/export so DSM backups can see the files.
ESTAB_DB_DATA_SOURCE=estab_db
ESTAB_APP_DATA_SOURCE=estab_data
ESTAB_EXPORT_DATA_SOURCE=estab_export

ESTAB_DB_NAME=estab
ESTAB_DB_USER=estab
ESTAB_ADMIN_USER=estab-admin

# Keep 127.0.0.1 on a workstation. On a NAS, use 0.0.0.0 only with a
# host firewall and preferably a TLS reverse proxy in front of this port.
ESTAB_HTTP_BIND=127.0.0.1
ESTAB_HTTP_PORT=8080
ESTAB_PUBLIC_URL=/
ESTAB_BASE_PATH=

ESTAB_ORGANISATION=Einsatzleitung
ESTAB_AUTHORITY_CODE=EL
ESTAB_ALLOW_SELF_REGISTRATION=true
ESTAB_ALLOW_LEGACY_LOGIN_WITHOUT_CSRF=false
ESTAB_TRUST_PROXY_HEADERS=false
ESTAB_UPLOAD_MAX_BYTES=5242880
TZ=Europe/Berlin
