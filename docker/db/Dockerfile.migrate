FROM mariadb:11.8.8@sha256:efb4959ef2c835cd735dbc388eb9ad6aab0c78dd64febcd51bc17481111890c4

LABEL org.opencontainers.image.title="eStab schema migrator" \
    org.opencontainers.image.description="Fresh-schema and versioned migration gate for eStab" \
    org.opencontainers.image.source="https://github.com/e-stab/estab"

COPY docker/db/migrate.sh /usr/local/bin/estab-migrate
COPY docker/db/init/10-schema.sql /opt/estab/schema/10-schema.sql
COPY docker/db/migrations/ /opt/estab/migrations/
COPY docker/db/verify.sql /opt/estab/verify.sql

RUN rm -f /usr/local/bin/gosu \
    && chmod 0755 /usr/local/bin/estab-migrate \
    && find /opt/estab -type f -name '*.sql' -exec chmod 0444 '{}' +

ENTRYPOINT ["/usr/local/bin/estab-migrate"]
