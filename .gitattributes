# Binary historical documents and media must remain byte-identical.
*.bmp binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.JPG binary
*.odt binary
*.ods binary
*.ott binary
*.pap binary
*.pdf binary
*.png binary
*.ttf binary
*.wav binary
*.xcf binary
*.zip binary
tests/fixtures/*.eml binary

# Historical BOS reference pages are checksum-protected source material.
stabinfo/*.html binary

# Most imported PHP sources intentionally retain their historical CRLF endings.
*.php whitespace=trailing-space,space-before-tab,cr-at-eol
