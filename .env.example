# Copy this file to .env. Store each actual password in the referenced file.
# The secrets directory is excluded from the image context; never commit it.
ESTAB_DB_PASSWORD_SECRET_FILE=./secrets/db_password.txt
ESTAB_DB_ROOT_PASSWORD_SECRET_FILE=./secrets/db_root_password.txt
ESTAB_ADMIN_PASSWORD_SECRET_FILE=./secrets/admin_password.txt

ESTAB_DB_NAME=estab
ESTAB_DB_USER=estab
ESTAB_ADMIN_USER=estab-admin

# Bind to loopback by default. Set 0.0.0.0 only behind a secured reverse proxy.
ESTAB_HTTP_BIND=127.0.0.1
ESTAB_HTTP_PORT=8080
# "/" keeps browser links portable across localhost, LAN IPs and reverse proxies.
# Set an absolute URL only when one canonical external address is guaranteed.
ESTAB_PUBLIC_URL=/
ESTAB_BASE_PATH=

ESTAB_ORGANISATION=Einsatzleitung
ESTAB_AUTHORITY_CODE=EL
# Sichere Voreinstellung: Konten werden in der Administration angelegt.
ESTAB_ALLOW_SELF_REGISTRATION=false
# Standardmäßig aus: nur für ausdrücklich benötigte direkte Legacy-Clients.
ESTAB_ALLOW_LEGACY_LOGIN_WITHOUT_CSRF=false
# Bei true zusätzlich die direkte Proxy-IP oder ein enges IP/CIDR-Netz setzen.
ESTAB_TRUST_PROXY_HEADERS=false
ESTAB_TRUSTED_PROXIES=
ESTAB_UPLOAD_MAX_BYTES=20971520
# Gesamtsicherheitsgrenze für Originalanhänge in einem PDF-Einsatzdossier.
ESTAB_PDF_ATTACHMENT_MAX_BYTES=52428800
TZ=Europe/Berlin
